# Copiar a .env SOLO para desarrollo local (el archivo .env no se versiona). En Render se definen en el panel / render.yaml.
# Lista completa y explicada: docs/CONFIGURACION.md

# --- Obligatorias en producción (NODE_ENV=production) ---
# MASTER_PASSWORD=una-contraseña-larga-de-al-menos-12-caracteres
# NODE_ENV=production

# --- Recomendadas ---
# PUBLIC_BASE_URL=https://appsincronizado.onrender.com
# ALLOWED_ORIGINS=https://appsincronizado.onrender.com
# REDIS_URL=redis://localhost:6379        # estado compartido: necesario con más de una instancia/proceso
# METRICS_TOKEN=token-para-prometheus

# --- Opcionales ---
# FLASH_DEFAULT_ENABLED=false               # estado inicial del acceso a la app Flash (/flash); el operador lo cambia desde /master
# PORT=10000
# LOG_LEVEL=info
# COMMAND_LEAD_MS=1500
# STROBE_ALLOWED=true
# MAX_STROBE_HZ=3
# CLUSTER_WORKERS=1                       # >1 requiere REDIS_URL
